# Copy to .env (gitignored) and fill in. Never put access keys here: they stay in your AWS profile.

# The AWS profile whose credentials belong to the hackathon account.
AWS_PROFILE=
AWS_REGION=us-east-1
# Live calls are refused unless the profile's account matches this ID.
DEMOTRACE_AWS_ACCOUNT_ID=

MODEL_ID=anthropic.claude-opus-5-5
