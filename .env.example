# Copy to .env (gitignored) and fill in. Never commit this file with values.

# Direct Claude API. The production Lambda reads this value from AWS Secrets Manager;
# local development can read it from this ignored file instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# The AWS profile whose credentials belong to the hackathon account.
AWS_PROFILE=
AWS_REGION=us-east-1
# Live calls are refused unless the profile's account matches this ID.
DEMOTRACE_AWS_ACCOUNT_ID=
