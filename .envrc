# direnv: inside this folder, plain `aws` and SDK commands use the project's AWS profile from the
# local, gitignored .env (AWS_PROFILE, AWS_REGION, DEMOTRACE_AWS_ACCOUNT_ID). Leaving the folder
# unloads it, so everywhere else your default AWS profile applies as before.
dotenv_if_exists .env
export AWS_DEFAULT_REGION="${AWS_REGION:-us-east-1}"
